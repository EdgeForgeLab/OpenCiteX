# -----------------------------------------------------------------------------
# OpenCiteX environment template
# Copy to `.env` for local Docker Postgres, or set the same keys in Vercel.
# Provider API keys are BYOK: paste them in Settings. They are encrypted
# with AES-256-GCM and stored in Postgres (never returned to the browser).
# -----------------------------------------------------------------------------

# Local Docker (docker compose up -d)
DATABASE_URL="postgresql://opencitex:opencitex@localhost:5432/opencitex?schema=public"

# Supabase Postgres (Dashboard → Project Settings → Database)
# Use the pooled URI for the app, and a direct URI for Prisma migrations:
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 32-byte key as 64 hex chars. Required to save or run with BYOK keys,
# and used to sign the admin session cookie unless AUTH_SECRET is set.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# Optional. Session HMAC secret. Defaults to ENCRYPTION_KEY.
# AUTH_SECRET=""
